@startuml
title Pizzas API - Class Diagram

package "Presentation Layer" {
    class Router {
      +GET /api/ingredients
      +POST /api/ingredients
      +GET /api/ingredients/:id
      +PUT /api/ingredients/:id
      +DELETE /api/ingredients/:id
      +GET /api/pizzas
      +POST /api/pizzas
      +GET /api/pizzas/:id
      +PUT /api/pizzas/:id
      +DELETE /api/pizzas/:id
    }
}

package "Business Layer" {
    class PizzasController {
      +create(req, res)
      +findAll(req, res)
      +findOne(req, res)
      +update(req, res)
      +delete(req, res)
    }

    class IngredientsController {
      +create(req, res)
      +findAll(req, res)
      +findOne(req, res)
      +update(req, res)
      +delete(req, res)
    }
}

package "Data Layer" {
    class Pizza {
      +int id
      +string title
      +string ingredients
      +string image
      +float price
      +string created_at
      +string updated_at
      +static create(obj) : Promise<Pizza>
      +static findAll() : Promise<Pizza[]>
      +static findById(id) : Promise<Pizza|null>
      +static update(id, obj) : Promise<Pizza|null>
      +static delete(id) : Promise<number>
    }

    class Ingredient {
      +int id
      +string name
      +float price
      +string created_at
      +string updated_at
      +static create(obj) : Promise<Ingredient>
      +static findAll() : Promise<Ingredient[]>
      +static findById(id) : Promise<Ingredient|null>
      +static update(is, obj) : Promise<Ingredient|null>
      +static delete(id) : Promise<number>
    }

    class PizzaHasIngredient {
      +int pizza_id
      +int ingredient_id
    }
}

IngredientsController -- Ingredient : uses >
Router --> IngredientsController : routes to >

PizzasController -- Pizza : uses >
PizzasController -- PizzaHasIngredient : uses >
PizzasController -- IngredientsController : validates ingredients >
Router --> PizzasController : routes to >

Ingredient -- PizzaHasIngredient : 0..* 1
Pizza -- PizzaHasIngredient : 0..* 1

@enduml
